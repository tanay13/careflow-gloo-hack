# ---- Model provider (OpenAI-compatible, e.g. Gloo AI Studio) ----
# Leave USE_MOCK_LLM=true for the offline deterministic demo (recommended on poor Wi-Fi).
USE_MOCK_LLM=true
LLM_API_KEY=
LLM_BASE_URL=            # e.g. https://<provider-host>/v1   (must expose /chat/completions)
LLM_MODEL=               # exact model id; record it in docs/agent-build-doc.md
LLM_TIMEOUT_S=25
# USD per 1K tokens, used for the cost estimate shown in the UI
LLM_COST_INPUT_PER_1K=0.00015
LLM_COST_OUTPUT_PER_1K=0.0006

# ---- Demo behaviour ----
DEMO_STEP_DELAY_MS=450           # visible pacing between agent steps (0 = instant)
DEMO_NOW=2026-10-06T09:00:00     # fixed demo clock (Tuesday) for deterministic schedules
APPROVAL_SECRET=change-me        # HMAC secret for approval tokens
DATABASE_URL=                    # default: sqlite file at backend/careflow.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
